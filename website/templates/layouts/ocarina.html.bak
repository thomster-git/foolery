      { n: 'D5', dur: 'q' }, { n: 'D5', dur: 'e' }, { n: 'Eb5', dur: 'q' }, { n: 'D5', dur: 'q' }, { break: true },
      
      { n: 'C5', dur: 'e' }, { n: 'Bb4', dur: 'e' }, { n: 'Ab4', dur: 'q' }, { n: 'G4', dur: 'h' }, { break: true },
      { n: 'Ab4', dur: 'q' }, { n: 'Ab4', dur: 'e' }, { n: 'G4', dur: 'e' }, { n: 'Ab4', dur: 'e' }, { n: 'Bb4', dur: 'e' }, { n: 'C5', dur: 'q' }, { break: true },
      
      { n: 'G4', dur: 'q' }, { n: 'C5', dur: 'q' }, { n: 'C5', dur: 'e' }, { n: 'C5', dur: 'q' }, { break: true },
      { n: 'D5', dur: 'q' }, { n: 'D5', dur: 'e' }, { n: 'Eb5', dur: 'q' }, { n: 'D5', dur: 'q' }, { break: true },
      
      { n: 'C5', dur: 'e' }, { n: 'Bb4', dur: 'e' }, { n: 'Ab4', dur: 'q' }, { n: 'G4', dur: 'h' }, { break: true },
      { n: 'Ab4', dur: 'q' }, { n: 'Ab4', dur: 'e' }, { n: 'G4', dur: 'e' }, { n: 'Ab4', dur: 'e' }, { n: 'Bb4', dur: 'e' }, { n: 'C5', dur: 'q' }
    ]
  }
};


function getFingering(noteName) {
  // Try exact match first, then enharmonic
  const enharmonics = { 'D#': 'Eb', 'Eb': 'D#', 'G#': 'Ab', 'Ab': 'G#', 'A#': 'Bb', 'Bb': 'A#', 'C#': 'Db', 'Db': 'C#', 'F#': 'Gb', 'Gb': 'F#' };
  const octave = noteName.match(/\d/)?.[0] || '';
  const baseName = noteName.replace(/\d/, '');
  for (const f of FINGERINGS) {
    if (f.note === noteName) return f;
    if (f.note === baseName + octave) return f;
    if (enharmonics[baseName] && f.note === enharmonics[baseName] + octave) return f;
  }
  return null;
}

function durLabel(dur) {
  return { 'q': '♩', 'h': '𝅗𝅥', 'e': '♪', 'w': '𝅝' }[dur] || dur;
}

function loadSong(id, btn) {
  // Update active button
  document.querySelectorAll('.song-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');

  const song = SONGS[id];
  if (!song) return;

  const display = document.getElementById('song-display');
  const notesHtml = song.notes.map((beat, i) => {
    if (beat.break) {
      return `<div style="flex-basis: 100%; height: 1.5rem; border-bottom: 1px dashed rgba(255,255,255,0.1); margin-bottom: 1rem;"></div>`;
    }
    const f = getFingering(beat.n);
    const svg = f ? renderHoleSVG(f.holes, f.thumbs) : `<div style="color:var(--text-muted);font-size:0.7rem;">(no chart)</div>`;
    return `
      <div class="note-beat">
        <div class="note-name">${beat.n}</div>
        <div style="font-size:0.75rem;color:var(--text-muted);">${durLabel(beat.dur)}</div>
        ${svg}
      </div>
    `;
  }).join('');

  display.innerHTML = `
    <h3 style="color: var(--text-main); margin-bottom: 0.25rem;">${song.title}</h3>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.75rem;">${song.info}</p>
    <div class="song-notes">${notesHtml}</div>
    <div style="margin-top: 1.5rem; font-size: 0.8rem; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 1rem;">
      ♩ = quarter note &nbsp;|&nbsp; 𝅗𝅥 = half note &nbsp;|&nbsp; ♪ = eighth note
    </div>
  `;
}

// ============================================================
// TAB SWITCHING
// ============================================================

function switchTab(tab) {
  document.querySelectorAll('.oc-panel').forEach(p => p.style.display = 'none');
  document.querySelectorAll('.oc-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('tab-' + tab).style.display = 'block';
  document.querySelector(`[data-tab="${tab}"]`).classList.add('active');

  // Stop tuner if leaving tuner tab
  if (tab !== 'tuner' && analyser) stopTuner();
}

// ============================================================
// INIT
// ============================================================

document.addEventListener('DOMContentLoaded', () => {
  buildFingerChart();
  loadSong('zeldas-lullaby', document.querySelector('[data-song="zeldas-lullaby"]'));
});
</script><div class="song-nav">
      <button class="song-btn active" onclick="loadSong('zeldas-lullaby', this)">Zelda's Lullaby</button>
      <button class="song-btn" onclick="loadSong('eponas-song', this)">Epona's Song</button>
      <button class="song-btn" onclick="loadSong('littleroot', this)">Littleroot Town</button>
      <button class="song-btn" onclick="loadSong('blue-bird', this)">Blue Bird</button>

