      { n: 'E4', dur: 'q' }, { n: 'G4', dur: 'q' }, { n: 'D4', dur: 'h' }, { break: true },
      { n: 'E4', dur: 'q' }, { n: 'G4', dur: 'q' }, { n: 'D5', dur: 'q' }, { n: 'C5', dur: 'q' }, { n: 'G4', dur: 'q' }, { break: true },
      { n: 'F4', dur: 'q' }, { n: 'E4', dur: 'q' }, { n: 'D4', dur: 'h' }, { break: true },
      
      { n: 'E4', dur: 'q' }, { n: 'G4', dur: 'q' }, { n: 'D4', dur: 'h' }, { break: true },
      { n: 'E4', dur: 'q' }, { n: 'G4', dur: 'q' }, { n: 'D4', dur: 'h' }, { break: true },
      { n: 'E4', dur: 'q' }, { n: 'G4', dur: 'q' }, { n: 'D5', dur: 'q' }, { n: 'C5', dur: 'q' }, { n: 'G4', dur: 'q' }, { break: true },
      { n: 'F4', dur: 'q' }, { n: 'E4', dur: 'q' }, { n: 'F4', dur: 'q' }, { n: 'E4', dur: 'q' }, { n: 'C4', dur: 'h' }
    ],
  },
  'eponas-song': {
    title: "Epona's Song (Full Version)",
    info: "The complete equestrian melody, including the bridge section.",
    notes: [
      { n: 'D5', dur: 'q' }, { n: 'B4', dur: 'q' }, { n: 'A4', dur: 'h' }, { break: true },
      { n: 'D5', dur: 'q' }, { n: 'B4', dur: 'q' }, { n: 'A4', dur: 'h' }, { break: true },
      { n: 'D5', dur: 'q' }, { n: 'B4', dur: 'q' }, { n: 'A4', dur: 'q' }, { n: 'B4', dur: 'q' }, { n: 'A4', dur: 'h' }, { break: true },
      
      { n: 'D4', dur: 'q' }, { n: 'F4', dur: 'q' }, { n: 'A4', dur: 'h' }, { break: true },
      { n: 'D4', dur: 'q' }, { n: 'F4', dur: 'q' }, { n: 'A4', dur: 'h' }, { break: true },
      { n: 'B4', dur: 'q' }, { n: 'A4', dur: 'q' }, { n: 'F4', dur: 'h' }, { break: true },
      
      { n: 'D4', dur: 'q' }, { n: 'F4', dur: 'q' }, { n: 'A4', dur: 'h' }, { break: true },
      { n: 'D4', dur: 'q' }, { n: 'F4', dur: 'q' }, { n: 'A4', dur: 'h' }, { break: true },
      { n: 'D5', dur: 'q' }, { n: 'B4', dur: 'q' }, { n: 'A4', dur: 'h' }
    ],
  },
  'littleroot': {
    title: "Littleroot Town",
    info: "A peaceful starting town theme from Pokémon Ruby/Sapphire/Emerald.",
    notes: [
      { n: 'F4', dur: 'q' }, { n: 'Bb4', dur: 'q' }, { n: 'A4', dur: 'q' }, { n: 'Bb4', dur: 'q' }, { break: true },
      { n: 'C5', dur: 'h' }, { n: 'D5', dur: 'h' }, { break: true },
      { n: 'F5', dur: 'q' }, { n: 'D5', dur: 'q' }, { n: 'C5', dur: 'q' }, { n: 'Bb4', dur: 'q' }, { break: true },
      { n: 'C5', dur: 'h' }, { n: 'D5', dur: 'h' }, { break: true },
      
      { n: 'F4', dur: 'q' }, { n: 'Bb4', dur: 'q' }, { n: 'A4', dur: 'q' }, { n: 'Bb4', dur: 'q' }, { break: true },
      { n: 'C5', dur: 'h' }, { n: 'D5', dur: 'h' }, { break: true },
      { n: 'F5', dur: 'q' }, { n: 'D5', dur: 'q' }, { n: 'C5', dur: 'q' }, { n: 'Bb4', dur: 'q' }, { break: true },
      { n: 'A4', dur: 'h' }, { n: 'F4', dur: 'h' }
    ],
  },
  'blue-bird': {
    title: "Blue Bird (Naruto Shippuden)",
    info: "The energetic third opening theme from Naruto Shippuden by Ikimono-gakari.",
    notes: [
